{
  "name": "SER8 HTTP 상태 확인 (수동)",
  "nodes": [
    {
      "parameters": {},
      "id": "6f1c0d2a-0001-4a00-9000-000000000001",
      "name": "수동 실행",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"services\": [\n    { \"name\": \"Open WebUI\", \"url\": \"http://<container-reachable-host>:<port>/health\" }\n  ]\n}",
        "options": {}
      },
      "id": "6f1c0d2a-0002-4a00-9000-000000000002",
      "name": "대상 목록",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "services",
        "options": {}
      },
      "id": "6f1c0d2a-0003-4a00-9000-000000000003",
      "name": "대상 분리",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [440, 0]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "6f1c0d2a-0004-4a00-9000-000000000004",
      "name": "하나씩 확인",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [660, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "startedAt",
              "value": "={{ $now.toMillis() }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "6f1c0d2a-0005-4a00-9000-000000000005",
      "name": "시작 시각",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, 100]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          },
          "timeout": 5000
        }
      },
      "id": "6f1c0d2a-0006-4a00-9000-000000000006",
      "name": "HTTP 요청",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 100],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "service",
              "value": "={{ $('시작 시각').item.json.name }}",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "statusCode",
              "value": "={{ $json.statusCode ?? null }}",
              "type": "number"
            },
            {
              "id": "b3",
              "name": "ok",
              "value": "={{ !$json.error && $json.statusCode >= 200 && $json.statusCode < 400 }}",
              "type": "boolean"
            },
            {
              "id": "b4",
              "name": "responseMs",
              "value": "={{ $now.toMillis() - $('시작 시각').item.json.startedAt }}",
              "type": "number"
            },
            {
              "id": "b5",
              "name": "error",
              "value": "={{ $json.error ? ($json.error.message || JSON.stringify($json.error)) : '' }}",
              "type": "string"
            },
            {
              "id": "b6",
              "name": "checkedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "6f1c0d2a-0007-4a00-9000-000000000007",
      "name": "결과 정리",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 100]
    },
    {
      "parameters": {},
      "id": "6f1c0d2a-0008-4a00-9000-000000000008",
      "name": "전체 결과",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [880, -120]
    }
  ],
  "connections": {
    "수동 실행": {
      "main": [[{ "node": "대상 목록", "type": "main", "index": 0 }]]
    },
    "대상 목록": {
      "main": [[{ "node": "대상 분리", "type": "main", "index": 0 }]]
    },
    "대상 분리": {
      "main": [[{ "node": "하나씩 확인", "type": "main", "index": 0 }]]
    },
    "하나씩 확인": {
      "main": [
        [{ "node": "전체 결과", "type": "main", "index": 0 }],
        [{ "node": "시작 시각", "type": "main", "index": 0 }]
      ]
    },
    "시작 시각": {
      "main": [[{ "node": "HTTP 요청", "type": "main", "index": 0 }]]
    },
    "HTTP 요청": {
      "main": [[{ "node": "결과 정리", "type": "main", "index": 0 }]]
    },
    "결과 정리": {
      "main": [[{ "node": "하나씩 확인", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
